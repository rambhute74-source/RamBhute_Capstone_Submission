{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "CloudServe Support Operational Overview (Setup Guide Section 06)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Tickets Processed Per Hour (By Channel & Outcome)",
      "description": "Tickets processed per hour, split by channel and by outcome (Setup Guide Section 06)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum by (channel, outcome) (rate(tickets_processed_total[1h])) * 3600",
          "legendFormat": "{{channel}} - {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "tickets/hour"
        }
      }
    },
    {
      "id": 2,
      "title": "Automation Proportion (Auto-Respond vs Escalation)",
      "description": "The proportion answered automatically against the proportion escalated (Setup Guide Section 06)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(tickets_processed_total[24h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Response Latency (P50 Median & P95)",
      "description": "Response latency at the median and the ninety-fifth percentile (Setup Guide Section 06)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(response_seconds_bucket[5m])))",
          "legendFormat": "P50 Median Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(response_seconds_bucket[5m])))",
          "legendFormat": "P95 Percentile Latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 3.0 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Guardrail Activations Over Time",
      "description": "Guardrail activations, by guardrail, over time (Setup Guide Section 06)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "sum by (guardrail) (rate(guardrail_blocks_total[5m]))",
          "legendFormat": "Guardrail: {{guardrail}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars"
          },
          "unit": "blocks/sec"
        }
      }
    },
    {
      "id": 5,
      "title": "Distribution of Confidence Scores (Model Drift Detection)",
      "description": "The distribution of confidence scores, which is where drift shows up first (Setup Guide Section 06)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum by (le) (increase(intent_confidence_score_bucket[1h]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kill Switch / Containment Status",
      "description": "Shows whether containment kill switch is engaged",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 17 },
      "targets": [
        {
          "expr": "kill_switch_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "NORMAL", "color": "green" }, "1": { "text": "CONTAINMENT ACTIVE", "color": "red" } }, "type": "value" }
          ]
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cloudserve", "prometheus", "capstone", "support-ai"],
  "time": {
    "from": "now-6h",
